CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ==========================================
# 1. 基础架构、防火墙与底层依赖 (fw4 核心 & 软硬件卸载)
# ==========================================
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
# 软硬件卸载管理后台 (系统自带的软件包/OPKG 管理界面，100% 包含)
CONFIG_PACKAGE_luci-app-opkg=y
# 防火墙高级 Web 页面管理
CONFIG_PACKAGE_luci-app-firewall=y

# ==========================================
# 2. 核心网络代理全家桶 (eBPF + 现代代理)
# ==========================================
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-app-turboacc=y

# ==========================================
# 3. 满血 eBPF & BTF 支持
# ==========================================
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_PACKAGE_kmod-veth=y

# ==========================================
# 4. 极致网络吞吐：BBR 拥塞控制 + FQ 队列管理
# ==========================================
CONFIG_KERNEL_TCP_CONG_BBR=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# ==========================================
# 5. N100 生产力必备：磁盘挂载与格式支持 (Samba/分区)
# ==========================================
# 磁盘分区与挂载核心工具 (Diskman 磁盘管理)
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-diskman=y
# 挂载必备文件系统格式驱动 (支持 ext4, NTFS, exFAT 等大容量移动硬盘)
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
# 挂载管理服务
CONFIG_PACKAGE_automount=y
# 局域网文件共享 (Samba4 支持)
CONFIG_PACKAGE_luci-app-samba4=y

# ==========================================
# 6. 轻量服务器核心：Docker 支持
# ==========================================
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-lib-docker=y

# ==========================================
# 7. 诊断、调试与系统工具
# ==========================================
# 网页终端（直接在网页里进 SSH）
CONFIG_PACKAGE_luci-app-ttyd=y
# 基础测速
CONFIG_PACKAGE_luci-app-netspeedtest=y
# 实时流量监控（看谁在抢网速）
CONFIG_PACKAGE_luci-app-wrtbwmon=y
# 网络调试与排错 (抓包、链路追踪、温度监控)
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_nano=y
# 自动分配网卡中断到多核 (N100 2000M 核心优化)
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_kmod-shortcut-fe=y
CONFIG_PACKAGE_kmod-shortcut-fe-cm=y

# ==========================================
# 8. 智能联机与远程互联 (经典铁三角)
# ==========================================
# UPNP 自动端口映射 (游戏联机 NAT 优化)
CONFIG_PACKAGE_luci-app-upnp=y
# 动态 DNS (公网 IP 绑定域名)
CONFIG_PACKAGE_luci-app-ddns=y
# 网络唤醒 WOL (远程开机家里的电脑)
CONFIG_PACKAGE_luci-app-wol=y

# ==========================================
# 9. 颜值即正义：多主题大礼包
# ==========================================
# 主题一：Argon（永远的扁平化美学之王，支持自定义背景、暗黑模式）
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# 主题二：Design（极简北欧风，线条极其干净，非常适合强迫症）
CONFIG_PACKAGE_luci-theme-design=y
CONFIG_PACKAGE_luci-app-design-config=y

# 主题三：Edge（前卫的侧边栏设计，半透明磨砂玻璃质感，科技感爆棚）
CONFIG_PACKAGE_luci-theme-edge=y

# 主题四：Neoboot / Material（经典的谷歌质感 Material Design，流畅轻量）
CONFIG_PACKAGE_luci-theme-material=y

# 主题五：Bootstrap（官方最经典、最稳固的备用主题，用来应急防翻车）
CONFIG_PACKAGE_luci-theme-bootstrap=y
